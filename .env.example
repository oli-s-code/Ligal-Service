# EmailJS Konfiguration
# Ersetzen Sie diese Werte nach dem EmailJS-Setup
# Anleitung: siehe EMAILJS_SETUP.md

VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
